<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.socialnet.java_othello.DifficultyController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Button fx:id="easyButton" text="Easy" />
    <Button fx:id="mediumButton" text="Medium" />
    <Button fx:id="hardButton" text="Hard" />
    <Button fx:id="backButton" text="Back" />

</VBox>
